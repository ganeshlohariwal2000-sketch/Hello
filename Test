-- Master Anti-Anti-Stealer Outfit Copy Function
local function stealOutfitFromTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character or not localPlayer.Character then return end
    
    local targetChar = targetPlayer.Character
    local myChar = localPlayer.Character
    
    -- Step 1: Clear current clothing & accessories
    for _, obj in pairs(myChar:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("Accessory") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        end
    end
    
    -- Step 2: Force clone all target clothes/accessories (Bypasses anti-stealer)
    for _, obj in pairs(targetChar:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("Accessory") then
            pcall(function()
                local clone = obj:Clone()
                clone.Parent = myChar
            end)
        end
    end
    
    -- Step 3: Sync HumanoidDescription fallback
    local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    if targetHumanoid and myHumanoid then
        pcall(function()
            local desc = targetHumanoid:GetAppliedDescription()
            myHumanoid:ApplyDescription(desc)
        end)
    end
    
    print("Outfit successfully stolen from: " + targetPlayer.Name)
end

-- Function to update player list dynamically
local function refreshPlayerList()
    -- Purane buttons clear karo
    for _, child in pairs(scrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for _, p in pairs(players:GetPlayers()) do
        if p ~= localPlayer then
            count = count + 1
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 30)
            pBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.SourceSans
            pBtn.Parent = scrollingFrame
            
            pBtn.MouseButton1Click:Connect(function()
                stealOutfitFromTarget(p)
            end)
        end
    end
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 34)
end

-- Auto refresh list when players join or leave
players.PlayerAdded:Connect(refreshPlayerList)
players.PlayerRemoving:Connect(refreshPlayerList)

-- Refresh on open
openBtn.MouseButton1Click:Connect(function()
    if frame.Visible then
        refreshPlayerList()
    end
end)

-- Initial load
refreshPlayerList()
