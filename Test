-- Command Processing Engine (Prefix `:`)
local function processCommand(msg)
    if string.sub(msg, 1, 1) == ":" then
        local fullCmd = string.lower(string.sub(msg, 2))
        local args = {}
        for arg in string.gmatch(fullCmd, "%S+") do
            table.insert(args, arg)
        end
        
        local cmd = args[1]
        local val = tonumber(args[2])

        if cmd == "fly" then
            toggleFly()
        elseif cmd == "unfly" then
            if flying then toggleFly() end
        elseif cmd == "noclip" then
            noclip = true
        elseif cmd == "unnoclip" then
            noclip = false
        elseif cmd == "speed" and val then
            if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                localPlayer.Character.Humanoid.WalkSpeed = val
            end
        elseif cmd == "jump" and val then
            if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                localPlayer.Character.Humanoid.JumpPower = val
            end
        end
    end
end

textBox.FocusLost:Connect(function(enter)
    if enter then
        processCommand(textBox.Text)
        textBox.Text = ""
    end
end)

localPlayer.Chatted:Connect(function(msg)
    processCommand(msg)
end)
