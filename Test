-- 100% Working Ultimate Steal Logic
local function applyOutfit(targetPlayer)
    if not targetPlayer then return end
    
    task.spawn(function()
        local success, desc = pcall(function()
            return players:GetHumanoidDescriptionFromUserId(targetPlayer.UserId)
        end)
        
        if success and desc and localPlayer.Character then
            local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                pcall(function()
                    humanoid:ApplyDescription(desc)
                end)
            end
        else
            -- Fallback agar API block ho toh direct accessories aur clothes utha lo
            if targetPlayer.Character and localPlayer.Character then
                for _, v in pairs(localPlayer.Character:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
                        v:Destroy()
                    end
                end
                for _, v in pairs(targetPlayer.Character:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
                        pcall(function()
                            v:Clone().Parent = localPlayer.Character
                        end)
                    end
                end
            end
        end
    end)
end

-- Refresh Player List
local function loadPlayers()
    for _, child in pairs(scrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for _, p in pairs(players:GetPlayers()) do
        if p ~= localPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            btn.TextSize = 11
            btn.Font = Enum.Font.SourceSansBold
            btn.Parent = scrollingFrame
            
            btn.MouseButton1Click:Connect(function()
                applyOutfit(p)
            end)
        end
    end
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 34)
end

players.PlayerAdded:Connect(loadPlayers)
players.PlayerRemoving:Connect(loadPlayers)

openBtn.MouseButton1Click:Connect(function()
    if frame.Visible then
        loadPlayers()
    end
end)

loadPlayers()
